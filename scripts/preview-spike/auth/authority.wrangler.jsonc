{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-preview-spike-auth-development",
  "account_id": "00000000000000000000000000000001",
  "main": "authority.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  // SPIKE_QA_MANIFEST is supplied privately from the independently verified QA manifest.
  "durable_objects": {
    "bindings": [{ "name": "QA_PREVIEW_STATES", "class_name": "QaStablePreviewState" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QaStablePreviewState"] }],
  "services": [
    {
      "binding": "QA_REALM_AUTHORITY",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "NativeAuthRuntime",
    },
    {
      "binding": "QA_DEV_ACCESS",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "DevAccessRuntime",
    },
  ],
}

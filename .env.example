# Configuration template only. Keep every value blank in version control.
# Actual provider credentials must be least-privilege sandbox/development keys only.
# Production credentials belong in the approved secret/workload-identity system, never this file.

# WorkOS sandbox
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_AUTHKIT_DOMAIN=
WORKOS_CONNECT_APPLICATION_ID=
WORKOS_CONNECT_CLIENT_ID=
WORKOS_CONNECT_CLIENT_SECRET_REF=
WORKOS_WEBHOOK_SECRET=

# Infisical bootstrap
INFISICAL_API_URL=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT_SLUG=

# GitHub App. Installation IDs, repository IDs, and selected repositories belong in the Control DB.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# Cloudflare accounts and capability-specific deployer credentials
CLOUDFLARE_SYSTEM_ACCOUNT_ID=
CLOUDFLARE_RUNTIME_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_WFP_NAMESPACE=
CLOUDFLARE_API_TOKEN_CONTROL_DEPLOYER=
CLOUDFLARE_API_TOKEN_RUNTIME_DEPLOYER=
CLOUDFLARE_API_TOKEN_DOMAIN_PROVISIONER=
CLOUDFLARE_API_TOKEN_DNS_PROVISIONER=
CLOUDFLARE_API_TOKEN_R2_PROVISIONER=
CLOUDFLARE_API_TOKEN_USAGE_READER=

# R2 build artifacts; credentials must be restricted to the named bucket.
R2_BUILD_ARTIFACTS_ACCESS_KEY_ID=
R2_BUILD_ARTIFACTS_SECRET_ACCESS_KEY=
R2_BUILD_ARTIFACTS_ENDPOINT=
R2_BUILD_ARTIFACTS_BUCKET=

# Stripe test mode only; never use live keys in local or automated tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_TOPUP_PRICE_ID=

# Optional derived metering; configure only after its decision gates permit it.
OPENMETER_BASE_URL=
OPENMETER_API_KEY=

# Google Drive backup OAuth. User refresh tokens, account IDs, and selected folders belong in encrypted connection records.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Grafana Cloud OTLP
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_INSTANCE_ID=
GRAFANA_CLOUD_OTLP_TOKEN=
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=

# Sentry. The auth token is CI-only for releases and source maps.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=

# Turnstile is limited to browser-interactive anonymous signup and suspicious recharge.
# Automated tests use Cloudflare's documented fixed test credentials, not real provider credentials.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend platform mail: operator-only, never exposed to customer applications.
RESEND_API_KEY_DEV=
RESEND_API_KEY_PROD=
RESEND_PLATFORM_WARNING_API_KEY_DEV=
RESEND_PLATFORM_WARNING_API_KEY_PROD=
MAIL_DOMAIN_KEY_ENCRYPTION_KEY_BASE64_DEV=
MAIL_DOMAIN_KEY_ENCRYPTION_KEY_BASE64_PROD=
MAIL_WEBHOOK_SIGNING_KEY_DEV=
MAIL_WEBHOOK_SIGNING_KEY_PROD=
RESEND_WEBHOOK_SECRET_DEV=
RESEND_WEBHOOK_SECRET_PROD=
MAIL_WEBHOOK_SIGNING_KEY_DEV=
MAIL_WEBHOOK_SIGNING_KEY_PROD=

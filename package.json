{
  "name": "ohmyhost",
  "version": "0.0.0",
  "private": true,
  "description": "API-first hosting control plane",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.6.0",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm typecheck:root && turbo run typecheck",
    "typecheck:root": "tsc --project tsconfig.root.json --noEmit",
    "test": "turbo run build && vitest run --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "test:shards": "node scripts/test-shards.mjs",
    "verify:fast": "node scripts/verify-fast.mjs",
    "coverage": "pnpm test:coverage",
    "build": "turbo run build",
    "contracts:lint": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint ohmyhost@v1 --config redocly.yaml",
    "contracts:bundle": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly bundle ohmyhost@v1 --config redocly.yaml --output packages/contracts/generated/openapi.json --ext json --component-renaming-conflicts-severity=error",
    "contracts:check": "node scripts/check-contracts.mjs",
    "sdk-ts:generate": "node scripts/generate-sdk-ts.mjs",
    "sdk-ts:check": "node scripts/check-sdk-ts-drift.mjs",
    "sdk-ts:package": "node scripts/package-customer-client.mjs sdk",
    "customer-runtime:package": "node scripts/package-customer-client.mjs runtime",
    "customer-auth:package": "node scripts/package-customer-client.mjs auth",
    "product-cli:package": "node scripts/package-customer-client.mjs cli",
    "mcp:package": "node scripts/package-customer-client.mjs mcp",
    "customer-clients:package:test": "node --test tests/customer-clients-package.node-test.mjs",
    "plan:check": "node scripts/check-documentation.mjs",
    "test:node": "node --test --test-concurrency=1 tests/*.node-test.mjs && node --test apps/build-runner/sandbox/tests/*.test.mjs && node --test packages/build-broker/src/*.node-test.mjs && node --test --test-concurrency=1 \"scripts/preview-spike/**/*.test.mjs\"",
    "plan:check:test": "node --test tests/check-plan-structure.node-test.mjs tests/documentation-coverage.node-test.mjs",
    "platform:release": "node scripts/platform-release.mjs",
    "release:rehearse": "node scripts/release-rehearse.mjs",
    "release:train": "node scripts/release-train.mjs",
    "control-core:operator": "node scripts/control-core-operator.mjs",
    "control-core:manifest": "node scripts/control-core-manifest.mjs",
    "control-core:cutover": "node scripts/control-core-cutover.mjs",
    "control-core:smoke": "node scripts/control-core-smoke.mjs",
    "credit:cutover": "node scripts/credit-cutover.mjs",
    "credit:prices": "node scripts/credit-prices.mjs",
    "phase0:fake-provider-boundary:test": "node --test tests/fake-provider-production-boundary.node-test.mjs",
    "phase0:fake-provider-boundary:verify": "node scripts/check-fake-provider-production-boundary.mjs",
    "phase0:fake-provider-boundary": "pnpm build && pnpm phase0:fake-provider-boundary:verify",
    "phase1:auth-preflight:names": "node scripts/phase1-auth-preflight-names.mjs",
    "phase1:auth-preflight:capabilities": "node scripts/phase1-auth-preflight-capabilities.mjs",
    "phase1:auth-preflight:capabilities:producer": "node scripts/phase1-auth-preflight-capability-producer.mjs",
    "phase1:workos-management:deployment:prepare": "node scripts/prepare-workos-management-deployment.mjs",
    "phase1:workos-management:version:parse": "node scripts/parse-workos-management-version-receipt.mjs",
    "phase1:auth-preflight:capabilities:attested": "node scripts/phase1-auth-preflight-capabilities-attested.mjs",
    "phase1:auth-preflight": "node scripts/phase1-auth-preflight.mjs",
    "phase1:auth-sandbox": "node scripts/phase1-auth-sandbox.mjs",
    "phase1:credential-store-platform-proof": "pnpm --filter @ohmyhost/product-cli... build && node scripts/phase1-credential-store-platform-proof.mjs",
    "phase1:credential-store-platforms": "node scripts/phase1-credential-store-platforms.mjs",
    "phase1:credential-store-platforms:attested": "node scripts/phase1-credential-store-platforms-attested.mjs",
    "phase1:p1b": "node scripts/phase1-p1b.mjs",
    "phase1:p1a:red": "node scripts/phase1-p1a-red.mjs",
    "phase1:p1a": "node scripts/phase1-p1a.mjs",
    "phase1:verify": "node scripts/phase1-verify.mjs",
    "phase1:evidence-runner:test": "pnpm --filter @ohmyhost/workos-management... build && node --test tests/phase1-evidence-runner.node-test.mjs tests/phase1-p1b-runners.node-test.mjs tests/phase1-auth-sandbox.node-test.mjs tests/phase1-capability-producer.node-test.mjs tests/phase1-workos-capabilities-workflow.node-test.mjs tests/phase1-workos-management-deployment.node-test.mjs tests/phase1-credential-store-platforms.node-test.mjs tests/phase1-p1b.node-test.mjs",
    "phase1:product-cli-boundary:test": "node --test tests/product-cli-boundary.test.mjs",
    "phase1:product-cli-boundary": "pnpm --filter @ohmyhost/product-cli... build && node scripts/check-product-cli-boundary.mjs",
    "phase1:webhook-ingress-boundary": "pnpm --filter @ohmyhost/webhook-ingress boundary",
    "proof:application-root:test": "pnpm --filter @ohmyhost/source-fetcher... build && node --test tests/application-root-proof.node-test.mjs apps/build-runner/sandbox/tests/archive-cross-boundary.test.mjs",
    "proof:application-root": "pnpm --filter @ohmyhost/source-fetcher... build && pnpm --filter @ohmyhost/build-broker... build && pnpm --filter @ohmyhost/wfp-management... build && node scripts/application-root-proof.mjs",
    "proof:postgres-portability:test": "pnpm --filter @ohmyhost/project-recovery... build && node --test tests/postgres-portability.node-test.mjs",
    "proof:postgres-portability": "node scripts/postgres-portability-proof.mjs",
    "proof:better-auth": "pnpm --filter @ohmyhost/platform build && pnpm --filter @ohmyhost/customer-auth-better-auth build && node packages/customer-auth-better-auth/scripts/postgres-proof.mjs",
    "audit:moderate": "pnpm audit --audit-level=moderate && pnpm --dir fixtures/next-edge --ignore-workspace audit --audit-level=moderate && pnpm --dir fixtures/gateway-canary --ignore-workspace audit --audit-level=moderate",
    "ci:verify": "pnpm audit:moderate && pnpm plan:check && pnpm contracts:check && pnpm sdk-ts:check && pnpm phase1:product-cli-boundary:test && pnpm phase1:product-cli-boundary && pnpm phase1:webhook-ingress-boundary && pnpm proof:application-root:test && pnpm proof:postgres-portability:test && pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm coverage && pnpm test:node && pnpm phase0:fake-provider-boundary:verify",
    "public-clients:prepare": "node scripts/prepare-public-client-release.mjs",
    "public-clients:check": "node scripts/check-public-channels.mjs",
    "skills:surfaces": "node scripts/prepare-surface-reference.mjs",
    "docs:coverage": "node scripts/check-surface-documentation.mjs",
    "docs:check": "node scripts/check-documentation.mjs",
    "docs:preview": "node scripts/preview-documentation.mjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@eslint/js": "9.33.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.46.1",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "@zip.js/zip.js": "2.13.1",
    "acorn": "8.18.0",
    "age-encryption": "0.3.1",
    "es-module-lexer": "1.7.0",
    "esbuild": "0.28.2",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "jsdom": "29.0.0",
    "mermaid": "12.1.0",
    "miniflare": "5.20260907.0-alpha",
    "npm": "11.6.0",
    "prettier": "3.6.2",
    "turbo": "2.9.14",
    "turndown": "7.2.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1",
    "undici": "7.30.1",
    "vitest": "4.1.12",
    "yaml": "2.8.3"
  }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-browser-gateway-production",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "account_id": "00000000000000000000000000000001",
  "routes": [{ "pattern": "browser.ohmyho.st", "custom_domain": true }],
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_SETTLEMENT_JOURNAL", "class_name": "BrowserSettlementJournal" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrowserSettlementJournal"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "2213", "simple": { "limit": 3000, "period": 60 } },
    { "name": "PROJECT_LIMITER", "namespace_id": "2211", "simple": { "limit": 600, "period": 60 } },
  ],
  "services": [
    {
      "binding": "BROWSER_RUNTIME",
      "service": "ohmyho-control-store-production",
      "entrypoint": "BrowserGatewayRuntime",
    },
  ],
}

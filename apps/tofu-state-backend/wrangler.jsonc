{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-tofu-state-poc-private-fullstack",
  "account_id": "00000000000000000000000000000001",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "STATE_ORIGIN": "https://dev-state.omh-installation.example.test",
    "STATE_PREFIX": "poc-private-fullstack/",
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "ohmyho-tofu-state-development",
      "jurisdiction": "us",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "STATES", "class_name": "TofuStateObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TofuStateObject"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}

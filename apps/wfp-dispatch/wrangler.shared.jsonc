{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-gateway-poc-private-fullstack",
  "account_id": "00000000000000000000000000000001",
  "main": "src/shared-gateway-main.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DEV_AUTH_ATOMIC_MODE": "v1",
    "NATIVE_GATEWAY_LATENCY_PROFILE": "c5-development-v1",
    "PREVIEW_HOST_SUFFIX": "preview.dev.omh.st",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "logpush": false,
  "tail_consumers": [{ "service": "ohmyho-diagnostic-tail-poc-private-fullstack" }],
  "dispatch_namespaces": [
    {
      "binding": "DISPATCHER",
      "namespace": "ohmyho-poc-private-fullstack",
      "outbound": {
        "service": "ohmyho-wfp-egress-v3-poc-private-fullstack",
        "parameters": ["EGRESS_CONTEXT"],
      },
    },
  ],
  "services": [
    {
      "binding": "PREVIEW_RUNTIME",
      "service": "ohmyho-live-preview-poc-private-fullstack",
    },
    {
      "binding": "NATIVE_AUTH_US",
      "service": "ohmyho-native-auth-development-us",
      "entrypoint": "NativePublicService",
    },
    {
      "binding": "NATIVE_AUTH_EU",
      "service": "ohmyho-native-auth-development-eu",
      "entrypoint": "NativePublicService",
    },
    {
      "binding": "GATEWAY_ROUTING",
      "service": "ohmyho-control-api-poc-private-fullstack",
      "entrypoint": "GatewayRoutingService",
    },
    {
      "binding": "DEV_ACCESS",
      "service": "ohmyho-control-api-poc-private-fullstack",
      "entrypoint": "DevAccessService",
    },
    {
      "binding": "CREDIT_ADMISSION",
      "service": "ohmyho-control-api-poc-private-fullstack",
      "entrypoint": "RuntimeCreditService",
    },
  ],
  "ratelimits": [
    {
      "name": "DIAGNOSTIC_LIMITER",
      "namespace_id": "2417",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
}

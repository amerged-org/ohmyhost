{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-wfp-egress-production",
  "account_id": "00000000000000000000000000000001",
  "main": "src/outbound-main.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "MAIL_GATEWAY_ORIGIN": "https://ohmyho-mail-gateway-production.your-omh-account.workers.dev",
    "STORAGE_GATEWAY_ORIGIN": "https://ohmyho-storage-gateway-production.your-omh-account.workers.dev",
  },
  "services": [
    {
      "binding": "MAIL_GATEWAY",
      "service": "ohmyho-mail-gateway-production",
      "entrypoint": "MailEgressEntrypoint",
    },
    // The storage gateway has no public listener: this named entrypoint, reached only through
    // this binding, is its way in for customer Workers. The named class owns the relay role.
    {
      "binding": "STORAGE_GATEWAY",
      "service": "ohmyho-storage-gateway-production",
      "entrypoint": "StorageGatewayRelayEntrypoint",
    },
  ],
  // Persist only the relay's own closed-vocabulary failure lines (event, gateway, outcome, project);
  // invocation logs and traces stay off because this Worker sees the URL of every customer fetch.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false,
    },
    "traces": { "enabled": false },
  },
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-next-cache-poc-private-fullstack",
  "account_id": "00000000000000000000000000000001",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_OBJECT", "class_name": "NextCacheObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NextCacheObject"] }],
  "services": [
    {
      "binding": "NEXT_CACHE_RETIREMENT_AUTHORITY",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "NextCacheRetirementAuthorityRuntime",
    },
  ],
}

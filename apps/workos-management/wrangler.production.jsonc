{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyhost-workos-management-production",
  "account_id": "00000000000000000000000000000001",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "WORKOS_DEPLOYMENT": "production",
  },
  "services": [
    {
      "binding": "CONTROL_RUNTIME",
      "service": "ohmyho-control-store-production",
      "entrypoint": "WorkosRuntime",
    },
  ],
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}

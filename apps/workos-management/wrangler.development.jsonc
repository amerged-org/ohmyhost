{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyhost-workos-management-poc-private-fullstack",
  "account_id": "00000000000000000000000000000001",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "WORKOS_AUTHKIT_DOMAIN": "https://orderly-laugh-73-staging.authkit.app",
    "WORKOS_CONNECT_APPLICATION_ID": "connect_app_00000000000000000000000003",
    "WORKOS_CONNECT_CLIENT_ID": "client_00000000000000000000000027",
    "WORKOS_DEPLOYMENT": "development",
  },
  "services": [
    {
      "binding": "CONTROL_RUNTIME",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "WorkosRuntime",
    },
  ],
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}

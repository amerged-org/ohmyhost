{
  "name": "@ohmyhost/orchestrator",
  "version": "0.0.0",
  "private": true,
  "ohmyhost": {
    "deployment": "production",
    "fakeProviderBoundary": {
      "typescriptProject": "tsconfig.build.json",
      "artifactRoot": "dist",
      "entrypoints": [
        "src/index.ts"
      ],
      "bundles": []
    }
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental --tsBuildInfoFile typecheck.tsbuildinfo",
    "test": "vitest run --root ../.. apps/orchestrator/src"
  },
  "dependencies": {
    "@ohmyhost/contracts": "workspace:*",
    "@ohmyhost/platform": "workspace:*",
    "@ohmyhost/project-handles": "workspace:*"
  }
}

{
  "name": "@ohmyhost/credit-service",
  "version": "0.0.0",
  "private": true,
  "ohmyhost": {
    "deployment": "production",
    "fakeProviderBoundary": {
      "typescriptProject": "tsconfig.build.json",
      "artifactRoot": "dist",
      "entrypoints": [
        "src/worker-main.ts"
      ],
      "bundles": [
        {
          "entrypoint": "src/worker-main.ts",
          "metafile": "dist/worker-bundle/metafile.json"
        }
      ]
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && wrangler deploy --dry-run --outdir dist/worker-bundle --metafile dist/worker-bundle/metafile.json --config wrangler.jsonc",
    "test": "vitest run --root ../.. apps/credit-service/test",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental --tsBuildInfoFile typecheck.tsbuildinfo"
  },
  "dependencies": {
    "@ohmyhost/platform": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}

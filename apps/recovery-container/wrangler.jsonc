{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-recovery-container-poc-private-fullstack",
  "account_id": "00000000000000000000000000000001",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "RESOURCE_NAMESPACE": "poc-private-fullstack" },
  "durable_objects": {
    "bindings": [{ "name": "RECOVERY_SANDBOX", "class_name": "RecoverySandbox" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RecoverySandbox"] }],
  "containers": [
    {
      "name": "ohmyho-recovery-container-poc-private-fullstack",
      "class_name": "RecoverySandbox",
      "image": "../project-recovery-worker/container/Dockerfile",
      "image_build_context": "../project-recovery-worker",
      "instance_type": "standard-1",
      "max_instances": 10,
      "constraints": { "regions": ["ENAM", "WNAM"] },
      "rollout_active_grace_period": 900,
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "services": [
    {
      "binding": "NATIVE_RESTORE_JOB_STORE",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "NativeAuthRestoreJobRuntime",
    },
    {
      "binding": "NATIVE_RESTORE_ADMIN_US",
      "service": "ohmyho-native-auth-development-us",
      "entrypoint": "NativeAdminService",
    },
    {
      "binding": "NATIVE_RESTORE_ADMIN_EU",
      "service": "ohmyho-native-auth-development-eu",
      "entrypoint": "NativeAdminService",
    },
    {
      "binding": "NATIVE_RESTORE_POLICY_US",
      "service": "ohmyho-native-auth-development-us",
      "entrypoint": "NativePolicyService",
    },
    {
      "binding": "NATIVE_RESTORE_POLICY_EU",
      "service": "ohmyho-native-auth-development-eu",
      "entrypoint": "NativePolicyService",
    },
    {
      "binding": "NATIVE_RESTORE_PREPARATION_US",
      "service": "ohmyho-neon-management-poc-private-fullstack",
      "entrypoint": "NativeAuthRestorePreparationService",
    },
    {
      "binding": "NATIVE_RESTORE_PREPARATION_EU",
      "service": "ohmyho-neon-management-poc-private-fullstack",
      "entrypoint": "NativeAuthRestorePreparationService",
    },
    {
      "binding": "RECOVERY_CONTROL_STORE",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "RecoveryRuntime",
    },
  ],
}

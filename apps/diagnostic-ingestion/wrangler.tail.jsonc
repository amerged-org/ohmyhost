{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-diagnostic-tail",
  "main": "src/tail-main.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "RUNTIME_CONFIGURATION_STATE": "disabled", "DIAGNOSTIC_PRODUCER_ID": "disabled" },
  "queues": { "producers": [{ "binding": "DIAGNOSTIC_QUEUE", "queue": "ohmyho-diagnostics" }] },
}

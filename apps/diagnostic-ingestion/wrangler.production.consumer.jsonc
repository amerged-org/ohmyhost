{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-diagnostic-consumer-production",
  "account_id": "00000000000000000000000000000001",
  "main": "src/consumer-main.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "RUNTIME_CONFIGURATION_STATE": "configured",
    "DIAGNOSTIC_PRODUCER_ID": "ohmyho-diagnostic-tail-production",
  },
  "triggers": { "crons": ["17 * * * *"] },
  "queues": {
    "consumers": [
      {
        "queue": "ohmyho-diagnostics-production",
        "dead_letter_queue": "ohmyho-diagnostics-dlq-production",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "services": [
    {
      "binding": "DIAGNOSTIC_CONSUMER_RUNTIME",
      "service": "ohmyho-control-store-production",
      "entrypoint": "DiagnosticConsumerRuntime",
    },
  ],
}

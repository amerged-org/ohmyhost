{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-diagnostic-tail-poc-private-fullstack",
  "main": "src/tail-main.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "RUNTIME_CONFIGURATION_STATE": "configured",
    "DIAGNOSTIC_PRODUCER_ID": "poc-private-fullstack",
  },
  "queues": {
    "producers": [
      { "binding": "DIAGNOSTIC_QUEUE", "queue": "ohmyho-diagnostics-poc-private-fullstack" },
    ],
  },
}

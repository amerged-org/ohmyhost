{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-source-fetcher-production",
  "account_id": "00000000000000000000000000000001",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "MANAGED_ARTIFACTS_ACCOUNT_ID": "00000000000000000000000000000001",
    "MANAGED_ARTIFACTS_NAMESPACE_US": "ohmyhost-production-us",
    "MANAGED_ARTIFACTS_NAMESPACE_EU": "ohmyhost-production-eu",
    "BUILD_OBJECTS_BUCKET_US": "ohmyho-builds-production",
    "BUILD_OBJECTS_BUCKET_EU": "ohmyho-builds-production-eu",
    "GITHUB_APP_CLIENT_ID": "Iv23Example000000002",
    "GITHUB_APP_SLUG": "example-omh-production",
    "GITHUB_OAUTH_REDIRECT_URI": "https://app.ohmyho.st/v1/github/oauth/callback",
    "GITHUB_USER_AGENT": "ohmyhost-source-fetcher/production",
    "SOURCE_ARCHIVE_MAX_BYTES": "25000000",
    "SOURCE_FETCH_TIMEOUT_MS": "30000",
    "PROVIDER_REQUEST_TIMEOUT_MS": "10000",
    "BINDING_REQUEST_TIMEOUT_MS": "10000",
  },
  "artifacts": [
    { "binding": "ARTIFACTS_US", "namespace": "ohmyhost-production-us" },
    { "binding": "ARTIFACTS_EU", "namespace": "ohmyhost-production-eu" },
  ],
  "r2_buckets": [
    {
      "binding": "MANAGED_SOURCE_STAGING_US",
      "bucket_name": "ohmyho-builds-production",
      "jurisdiction": "us",
    },
    {
      "binding": "MANAGED_SOURCE_STAGING_EU",
      "bucket_name": "ohmyho-builds-production-eu",
      "jurisdiction": "eu",
    },
  ],
  "services": [
    {
      "binding": "PREVIEW_CONTROL",
      "service": "ohmyho-control-store-production",
      "entrypoint": "PreviewSourceRuntime",
    },
    {
      "binding": "BUILD_RUNNER",
      "service": "ohmyho-build-runner-production",
      "entrypoint": "BuildRunnerService",
    },
  ],
  // GITHUB_APP_CLIENT_SECRET and the verified PKCS#8 DER/base64 GITHUB_APP_PRIVATE_KEY_BASE64 are independent Prod Worker secrets.
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-native-auth-development-us",
  "account_id": "00000000000000000000000000000001",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "persist": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "vars": {
    "PREVIEW_HOST_SUFFIX": "preview.dev.omh.st",
    "NATIVE_AUTH_REGION_ID": "us-dev",
    "NATIVE_AUTH_CUSTODY_KEY_VERSION": 20261106,
    "NATIVE_AUTH_LATENCY_PROFILE": "c5-development-v1",
    "NATIVE_AUTH_ATOMIC_SNAPSHOT_MODE": "v1",
  },
  // Activate new code, saved primary and every required historical reader atomically.
  "secrets": {
    "required": ["NATIVE_AUTH_CUSTODY_KEY_BASE64", "NATIVE_AUTH_CUSTODY_ADDITIONAL_KEYS_JSON"],
  },
  "durable_objects": {
    "bindings": [{ "name": "NATIVE_AUTH_ENVIRONMENTS", "class_name": "NativeAuthEnvironment" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NativeAuthEnvironment"] }],
  "services": [
    {
      "binding": "PREVIEW_CONTROL",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "PreviewTokenLookupRuntime",
    },
    {
      "binding": "NATIVE_AUTH_PRODUCT_PREVIEW_AUTHORITY",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "PreviewNativeAuthAuthorityRuntime",
    },
    {
      "binding": "NATIVE_AUTH_PRODUCT_PREVIEW_MAIL",
      "service": "ohmyho-mail-gateway-poc-private-fullstack",
      "entrypoint": "NativeProductPreviewAuthMailService",
    },
    {
      "binding": "NATIVE_AUTH_AUTHORITY",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "NativeAuthRuntime",
    },
    {
      "binding": "NATIVE_AUTH_PROVIDER_SECRETS",
      "service": "ohmyho-control-api-poc-private-fullstack",
      "entrypoint": "NativeAuthProviderSecretService",
    },
    {
      "binding": "NATIVE_AUTH_ADMIN_AUTHORITY",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "NativeAuthAdminAuthorityRuntime",
    },
    {
      "binding": "NATIVE_AUTH_REGISTRY_AUTHORITY",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "NativeAuthRegistryAuthorityRuntime",
    },
    {
      "binding": "NATIVE_AUTH_MAIL_AUTHORITY",
      "service": "ohmyho-control-store-poc-private-fullstack",
      "entrypoint": "NativeAuthMailRuntime",
    },
    {
      "binding": "NATIVE_AUTH_MAIL",
      "service": "ohmyho-mail-gateway-poc-private-fullstack",
      "entrypoint": "NativeAuthMailService",
    },
  ],
  "ratelimits": [
    {
      "name": "NATIVE_AUTH_GENERAL_LIMITER",
      "namespace_id": "2401",
      "simple": { "limit": 100, "period": 60 },
    },
    {
      "name": "NATIVE_AUTH_REALM_LIMITER",
      "namespace_id": "2421",
      "simple": { "limit": 3000, "period": 60 },
    },
    {
      "name": "NATIVE_AUTH_SIGNIN_LIMITER",
      "namespace_id": "2402",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "NATIVE_AUTH_SIGNUP_LIMITER",
      "namespace_id": "2403",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "NATIVE_AUTH_RESET_LIMITER",
      "namespace_id": "2404",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
}

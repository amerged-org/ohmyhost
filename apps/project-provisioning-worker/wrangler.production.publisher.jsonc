{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ohmyho-project-provisioning-publisher-production",
  "account_id": "00000000000000000000000000000001",
  "main": "src/publisher-main.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "RUNTIME_CONFIGURATION_STATE": "configured",
  },
  "queues": {
    "producers": [
      {
        "binding": "PROJECT_PROVISIONING_QUEUE",
        "queue": "ohmyho-project-provisioning-production",
      },
    ],
  },
  "triggers": { "crons": ["*/1 * * * *"] },
  "services": [
    {
      "binding": "PROJECT_DISPATCH_RUNTIME",
      "service": "ohmyho-control-store-production",
      "entrypoint": "ProjectDispatchRuntime",
    },
  ],
}
